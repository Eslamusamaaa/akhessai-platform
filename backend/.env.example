# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit real secrets.
# Used for local (non-docker) development: uvicorn main:app --reload

# OpenRouter (https://openrouter.ai/keys) — required for AI report generation
OPENROUTER_API_KEY=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fernet key for PHI column encryption (base64, 32 bytes) — generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=

# Optional overrides (defaults shown)
# DATABASE_URL=sqlite:///medical_assessment.db
# QDRANT_URL=http://localhost:6333
# LLM_MODEL=google/gemini-2.5-flash

# --- Security settings (added in the security-fixes update) ---
# production (default) refuses to start without JWT_SECRET and PHI_ENCRYPTION_KEY.
# Set APP_ENV=development ONLY on your own machine.
APP_ENV=production

# Comma-separated browser origins allowed to call the API directly.
# Not needed when the frontend proxies /api (the default Vercel setup).
# ALLOWED_ORIGINS=http://localhost:5173

# Demo accounts (admin/specialist/parent/teacher) are OFF by default.
# For a LOCAL demo only: set SEED_DEMO_USERS=true and a DEMO_PASSWORD of 12+ characters.
# Never enable this on a deployment that holds real data.
SEED_DEMO_USERS=false
DEMO_PASSWORD=
