# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# Used by docker-compose.yml when running `docker-compose up`.

# PostgreSQL (docker-compose local dev)
POSTGRES_PASSWORD=change_me

# Full Postgres connection string used by the FastAPI backend (backend/config.py).
# Local docker-compose: postgresql://postgres:change_me@localhost:5432/akhessai
# Vercel/production: your Neon connection string, pooled variant, e.g.
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Falls back to a local SQLite file if unset — never use that in production.
DATABASE_URL=

# OpenRouter (https://openrouter.ai/keys) — required for AI report generation
OPENROUTER_API_KEY=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Fernet key for PHI column encryption (base64, 32 bytes) — generate with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PHI_ENCRYPTION_KEY=

# Optional overrides
LLM_MODEL=google/gemini-2.5-flash

# --- RAG retrieval (Postgres + pgvector) ---
# Database holding the rag_documents table (backend/rag/schema.sql). Required in production:
# use the Neon *pooled* connection string, e.g.
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Defaults to DATABASE_URL. If it is not a Postgres URL (e.g. local SQLite), retrieval runs in memory.
# Load / refresh the corpus offline with:  cd backend && python -m rag.ingest --init-schema
# RAG_DATABASE_URL=
# pgvector (default) | memory (in-process search over rag/corpus.jsonl; tests)
# RAG_STORE=pgvector
# RAG_TABLE=rag_documents
# RAG_POOL_MAX=5
# Embedding model (sentence-transformers) and the tag stored on each row (embedding_model).
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_VERSION=paraphrase-multilingual-MiniLM-L12-v2

# --- Security settings (added in the security-fixes update) ---
# production (default) refuses to start without JWT_SECRET and PHI_ENCRYPTION_KEY.
# Set APP_ENV=development ONLY on your own machine.
APP_ENV=production

# Comma-separated browser origins allowed to call the API directly.
# Not needed when the frontend proxies /api (the default Vercel setup).
# ALLOWED_ORIGINS=http://localhost:5173

# Demo accounts (admin/specialist/parent/teacher) are OFF by default.
# For a LOCAL demo only: set SEED_DEMO_USERS=true and a DEMO_PASSWORD of 12+ characters.
# Never enable this on a deployment that holds real data.
SEED_DEMO_USERS=false
DEMO_PASSWORD=
